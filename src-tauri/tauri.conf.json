{
  "productName": "db-viewer",
  "version": "0.6.9",
  "identifier": "com.db-viewer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1440",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DB Viewer",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#282c34"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGQThFRTBDRUI0OTMyMUUKUldRZU1rbnJETzZvLzhNY3dkZU1XUGlONVZqRGhNUWxoelFyZElwb2YrSUYyS05mTUxsNnJ2MWcK",
      "endpoints": [
        "https://github.com/IvanG11/db-viewer/releases/latest/download/latest.json"
      ]
    }
  }
}
