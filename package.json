{
  "name": "tupledb",
  "private": true,
  "version": "0.7.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:unit": "vue-tsc -p tsconfig.test.json && node --test '.tmp-tests/tests/*.test.js'",
    "test:component": "vitest run",
    "preview": "vite preview",
    "dev:app": "npm run tauri:dev",
    "build:app": "npm run tauri:build",
    "tauri:dev": "node node_modules/@tauri-apps/cli/tauri.js dev",
    "tauri:build": "NO_STRIP=true node node_modules/@tauri-apps/cli/tauri.js build --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}'",
    "tauri:build:ci": "node node_modules/@tauri-apps/cli/tauri.js build",
    "tauri:build:linux": "node node_modules/@tauri-apps/cli/tauri.js build --config src-tauri/tauri.linux.conf.json",
    "tauri:build:macos": "node node_modules/@tauri-apps/cli/tauri.js build --config src-tauri/tauri.macos.conf.json",
    "release:build": "node scripts/build-signed-release.mjs",
    "release:publish": "node scripts/publish-github-release.mjs",
    "version:set": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@tanstack/vue-table": "^8.21.3",
    "@tanstack/vue-virtual": "^3.13.23",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "@tauri-apps/plugin-notification": "^2.2.1",
    "@tauri-apps/plugin-opener": "^2.2.3",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@vueuse/core": "^12.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "lucide-vue-next": "^0.474.0",
    "pinia": "^2.3.1",
    "reka-ui": "^2.1.2",
    "sql-formatter": "^15.7.3",
    "tailwind-merge": "^3.0.1",
    "uuid": "^11.0.5",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.3",
    "@tauri-apps/cli": "^2.2.3",
    "@types/node": "^22.13.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.9",
    "happy-dom": "^20.9.0",
    "tailwindcss": "^4.0.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^4.1.5",
    "vue-tsc": "^2.2.0"
  }
}
